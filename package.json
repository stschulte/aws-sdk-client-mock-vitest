{
  "name": "aws-sdk-client-mock-vitest",
  "version": "8.0.0",
  "description": "Custom matchers for AWS SDK Client mock to be used in vitest",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extend": {
      "types": "./dist/extend.d.ts",
      "default": "./dist/extend.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "tsc --noEmit",
    "all": "npm run validate && npm run lint && npm run build && npm run test:coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stschulte/aws-sdk-client-mock-vitest.git"
  },
  "author": "Stefan Schulte <stschulte@posteo.de>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stschulte/aws-sdk-client-mock-vitest/issues"
  },
  "homepage": "https://github.com/stschulte/aws-sdk-client-mock-vitest#readme",
  "peerDependencies": {
    "@smithy/types": ">=3.5.0",
    "aws-sdk-client-mock": ">=2.2.0",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-secrets-manager": "^3.1127.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/utils": "^5.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.10.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
